rules_version = '2';
// Regras do Hub Logístico. Cole no console do Firebase: Firestore Database > Regras > Publicar.
// - administrador: existe o documento admins/{uid} (criado só pelo console)
// - leitor: e-mail na lista meta/acesso.leitores (editada pelo administrador no site)
// - leitores só leem o que foi publicado; dados brutos só administradores
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function leitor() {
      return logado() && request.auth.token.email != null
        && get(/databases/$(database)/documents/meta/acesso).data.leitores.hasAny([request.auth.token.email]);
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;            // só pelo console do Firebase
    }
    match /publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /pes_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_pes {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /km_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_km {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /cargas_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_cargas {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /perdas_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_perdas {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /retorno_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_retorno {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /transp_publicado/{id} {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/publicacoes_transp {
      allow read: if admin() || leitor();
      allow write: if admin();
    }
    match /meta/acesso {
      allow read, write: if admin();
    }
    match /venda/{id}        { allow read, write: if admin(); }
    match /retorno/{id}      { allow read, write: if admin(); }
    match /planejamento/{id} { allow read, write: if admin(); }
    match /parametro/{id}    { allow read, write: if admin(); }
    match /estado/{id}       { allow read, write: if admin(); }
    match /importacao/{id}   { allow read, write: if admin(); }
    match /pes/{id}          { allow read, write: if admin(); }
    match /km_dados/{id}     { allow read, write: if admin(); }
    match /km_parametro/{id} { allow read, write: if admin(); }
    match /cargas_dados/{id} { allow read, write: if admin(); }
    match /perdas_dados/{id}     { allow read, write: if admin(); }
    match /perdas_parametro/{id} { allow read, write: if admin(); }
    match /retorno_dados/{id}     { allow read, write: if admin(); }
    match /retorno_parametro/{id} { allow read, write: if admin(); }
    match /transp_dados/{id}      { allow read, write: if admin(); }
    match /transp_ajuste/{id}     { allow read, write: if admin(); }
  }
}
